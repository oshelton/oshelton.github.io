{
	"name": "oshelton.github.io",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --open",
		"build": "npm run lint && npm run check && vite build",
		"preview": "vite preview --open",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generateBlogData": "nuke GenerateBlogData --configuration Release"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"flowbite-svelte": "1.33.1",
		"flowbite-svelte-icons": "3.1.0",
		"globals": "^17.12.0",
		"linq": "^4.0.2",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-exmarkdown": "^5.0.2",
		"svelte-icons-pack": "^3.1.3",
		"svelte-prism": "^1.1.6",
		"svelty-picker": "^6.1.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.2.2",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	}
}
